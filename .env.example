# ==========================================================================
# Nexus Access — configuración de entorno
# ==========================================================================
# Precedencia: variables de entorno reales > este archivo > config.conf >
# valores por defecto.  Ver config_loader.py
#
# Plantilla. Copiar a .env y rellenar:  cp .env.example .env
# ==========================================================================

# --- Base de datos (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus
DB_USER=
DB_PASS=

# --- Sistema ---
# Firma los JWT de sesión. Si cambia, todas las sesiones activas caducan.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# DEBUG=True activa el recargador y el depurador de Flask.
# NUNCA en producción: el depurador permite ejecutar código arbitrario.
DEBUG=False

# --- Authelia (forward-auth) ---
# Al activarlo, la identidad llega en headers Remote-* desde el proxy y Flask
# deja de autenticar por sí mismo. Los grupos definen rol y áreas:
#   nexus-admin              -> Administrador (global)
#   nexus-area-<slug-area>   -> AdministradorArea de esa área
#   cualquier otro           -> Usuario
AUTHELIA_ENABLED=False

# OBLIGATORIO cuando AUTHELIA_ENABLED=True. IPs (separadas por comas) que
# pueden inyectar headers Remote-*: la del proxy nginx/Traefik/Authelia.
#
# SEGURIDAD: sin esta lista los headers se ignoran por completo (fail-closed).
# Además, el puerto de Flask NO debe ser accesible desde fuera del proxy:
# cualquiera que lo alcance directamente podría enviar
# `Remote-Email: admin@empresa.com` y entrar como administrador.
AUTHELIA_TRUSTED_IPS=127.0.0.1

# Mantener el login local por contraseña como respaldo si el proxy cae.
LOCAL_LOGIN_FALLBACK=True

# --- Redis ---
# Declarado en requirements.txt pero aún sin uso en el código.
REDIS_ENABLED=True
REDIS_HOST=localhost
REDIS_PORT=6379
