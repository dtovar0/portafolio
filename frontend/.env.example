# ==========================================================================
# Frontend Next.js — configuración local
# ==========================================================================
# Copiar a .env.local:  cp .env.example .env.local
# ==========================================================================

# URL interna de la API Flask. Los rewrites de next.config.ts enrutan
# /api/* aquí, de modo que el navegador siempre habla con el mismo origen
# (sin CORS) y la cookie de sesión viaja sola.
#
# En producción, detrás de Authelia, apunta al servicio de Flask en la red
# interna. Ese puerto nunca debe estar expuesto públicamente.
FLASK_API_URL=http://127.0.0.1:5002
